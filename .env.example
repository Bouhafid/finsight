# SEC requires a descriptive User-Agent with a contact email.
SEC_USER_AGENT="FinSight your.name@example.com"

# Local Postgres from docker-compose.yml. DATABASE_URL, when set, wins.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=finsight
DB_USER=finsight
DB_PASSWORD=local_dev_password
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# LLM: "ollama" (local) or "azure".
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1/
OLLAMA_MODEL=qwen2.5:3b
# AZURE_OPENAI_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Parallel claim verifications (use 1 with a local Ollama).
VERIFY_WORKERS=4
